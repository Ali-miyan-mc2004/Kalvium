# --- LLM (one is required) ---------------------------------------------
# anthropic = Anthropic SDK. openai = any OpenAI-compatible endpoint.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# For LLM_PROVIDER=openai. Set OPENAI_BASE_URL for Gemini, Groq, OpenRouter
# or a local Ollama server (for example http://localhost:11434/v1).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional: run the QC layers on a different model from the generator, so
# the checker does not share the writer's blind spots.
QC_MODEL=

# --- Research (optional, but these improve research quality) -------------
# Wikipedia's robot policy requires contact details in the client's user
# agent. Set this to your project's repository URL or an email address.
LESSONFORGE_CONTACT=

# Wikipedia, MDN and Open Library need no key and always run.
# Web search uses Tavily if set, otherwise Anthropic's web search tool when
# LLM_PROVIDER=anthropic.
TAVILY_API_KEY=
# Official YouTube Data API v3. Without it, videos are found through web
# search and verified with YouTube's oEmbed endpoint.
YOUTUBE_API_KEY=
